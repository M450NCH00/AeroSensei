# Copy the relevant lines into a `.env` file next to docker-compose.yml.
# docker compose auto-loads ./.env. Do NOT commit real secrets.

# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric chat ids allowed to chat / receive pushes.
# Send /start to your bot to learn your chat id, then fill this in.
TELEGRAM_ALLOWED_CHAT_IDS=

# Shared secret required in the X-Notify-Secret header to POST /notify.
NOTIFY_SECRET=
